        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ crediti oltre i %2$@ inclusi in questo ciclo. Non vengono fatturati finché non è assegnato un piano, e le risposte continuano come sempre."
          }
        }
      }
    },
    "%@ credits past the %@ included, at %@ per credit. No spending limit is set, so extra credits are billed until the cycle resets on %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ credits past the %2$@ included, at %3$@ per credit. No spending limit is set, so extra credits are billed until the cycle resets on %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ crediti oltre i %2$@ inclusi, a %3$@ per credito. Non c'è un limite di spesa, quindi i crediti extra sono fatturati fino al rinnovo del ciclo, il %4$@."
          }
        }
      }
    },
    "%@ credits past the %@ included, at %@ per credit. Your spending limit is %@ per cycle." : {
