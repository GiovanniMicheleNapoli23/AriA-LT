    "You are editing the text, as the Markdown Aria wrote it, and the tables. Charts and other cards change by asking Aria in the chat. Saving makes a new version: Aria's original always stays." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are editing the text, as the Markdown Aria wrote it, and the tables. Charts and other cards change by asking Aria in the chat. Saving makes a new version: Aria's original always stays."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai modificando il testo, nel Markdown in cui l'ha scritto Aria, e le tabelle. Grafici e altre card si cambiano chiedendolo ad Aria in chat. Salvando crei una nuova versione: l'originale di Aria resta sempre."
          }
        }
      }
    },
    "You asked for %@, but it couldn’t be applied, so this reply ran at %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You asked for %1$@, but it couldn’t be applied, so this reply ran at %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avevi chiesto il livello %1$@, ma non è stato possibile applicarlo: questa risposta è stata generata con il livello %2$@."
          }
        }
      }
    },
    "You asked for %@, but it isn’t available on your plan, so this reply ran at %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You asked for %1$@, but it isn’t available on your plan, so this reply ran at %2$@."
