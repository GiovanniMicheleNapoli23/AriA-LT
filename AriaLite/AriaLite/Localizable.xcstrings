    "%@ will be signed out everywhere and will need a new sign-in link." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà disconnesso ovunque e avrà bisogno di un nuovo link di accesso."
