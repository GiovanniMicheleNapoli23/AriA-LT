    "Until %@, usage past each day's included credits stops. Usage within the daily credits still works. Raise the limit to resume right away." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino al %@, l'utilizzo oltre i crediti inclusi di ogni giorno si ferma. L'utilizzo entro i crediti giornalieri continua a funzionare. Alza il limite per riprendere subito."
          }
        }
      }
    },
    "Until %@, usage past the included credits stops. An owner can raise the limit." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino al %@, l'utilizzo oltre i crediti inclusi si ferma. Un proprietario può alzare il limite."
          }
        }
      }
    },
    "Until %@, usage past the included credits stops. Usage within the included credits still works. Raise the limit to resume right away." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino al %@, l'utilizzo oltre i crediti inclusi si ferma. L'utilizzo entro i crediti inclusi continua a funzionare. Alza il limite per riprendere subito."
          }
        }
      }
    },
