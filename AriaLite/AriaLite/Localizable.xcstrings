        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avevi chiesto il livello %1$@, ma non è disponibile nel tuo piano: questa risposta è stata generata con il livello %2$@."
          }
        }
      }
    },
    "You asked for %@, but your company’s spending limit is reached, so this reply ran at %@ on a lighter model." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You asked for %1$@, but your company’s spending limit is reached, so this reply ran at %2$@ on a lighter model."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avevi chiesto il livello %1$@, ma il limite di spesa dell’azienda è stato raggiunto: questa risposta è stata generata con il livello %2$@ e un modello più leggero."
          }
        }
      }
    },
    "You can add it later from the chat." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
