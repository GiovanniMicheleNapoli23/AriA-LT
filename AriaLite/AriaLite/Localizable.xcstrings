    "Remove the air filter and blow out dust and debris with compressed air. Replace the filter if it shows tears or excessive clogging." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the air filter and blow out dust and debris with compressed air. Replace the filter if it shows tears or excessive clogging."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi il filtro dell’aria e soffia via polvere e detriti con aria compressa. Sostituisci il filtro se presenta strappi o intasamento eccessivo."
          }
        }
      }
    },
    "Remove the front filters and blow out dust with low-pressure compressed air. Heavily clogged filters must be replaced to prevent overheating." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the front filters and blow out dust with low-pressure compressed air. Heavily clogged filters must be replaced to prevent overheating."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi i filtri anteriori e soffia via la polvere con aria compressa a bassa pressione. I filtri molto intasati devono essere sostituiti per evitare il surriscaldamento."
          }
        }
      }
    },
