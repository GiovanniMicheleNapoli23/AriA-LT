    },
    "“%@”" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”"
          }
        }
      }
    },
    "\"%@\" will be closed as cancelled." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" verrà chiuso come annullato."
          }
        }
      }
    },
    "“%@” will be deleted. This can't be undone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà eliminata. L'operazione non si può annullare."
          }
        }
      }
    },
    "“%@” will be marked as cancelled." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà segnato come annullato."
          }
        }
      }
    },
    "“%@” will be removed along with its memberships. This can't be undone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà rimossa insieme alle sue appartenenze. L'operazione non si può annullare."
          }
        }
      }
    },
    "“%@” will be removed for everyone. Work orders already created from it stay." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà rimosso per tutti. Gli ordini già creati da questo modello restano."
          }
        }
      }
    },
    "“%@” will be removed from Crafted. The data it shows isn't touched." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà tolto da Crafted. I dati che mostra non vengono toccati."
          }
        }
      }
    },
    "“%@” will be removed from your vendors. This can't be undone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sarà rimosso dai tuoi fornitori. L'operazione non si può annullare."
          }
        }
      }
    },
    "“%@” will be removed. Data linked to this plant can block the deletion. This can't be undone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verrà rimosso. I dati collegati a questo stabilimento possono impedirne l'eliminazione. L'operazione non si può annullare."
          }
        }
      }
    },
