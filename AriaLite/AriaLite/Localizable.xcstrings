    "%@ includes %lld users and your company has %lld. Everyone keeps their access, but new invitations are paused until you are within the limit or upgrade to %@." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e la tua azienda ne ha %3$lld. Tutti mantengono l'accesso, ma i nuovi inviti restano sospesi finché non rientri nel limite o passi a %4$@."
          }
        }
      }
    },
    "%@ includes %lld users and your company has %lld. Everyone keeps their access, but new invitations are paused until you are within the limit. Contact sales about Enterprise." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e la tua azienda ne ha %3$lld. Tutti mantengono l'accesso, ma i nuovi inviti restano sospesi finché non rientri nel limite. Contatta le vendite per Enterprise."
          }
        }
      }
    },
    "%@ includes %lld users, and pending invitations count. Revoke a pending invitation, or contact sales about Enterprise." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e gli inviti in sospeso contano. Revoca un invito in sospeso oppure contatta le vendite per Enterprise."
          }
        }
      }
    },
    "%@ includes %lld users, and pending invitations count. Revoke a pending invitation, or upgrade to %@ (%@ a month, up to %lld users)." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e gli inviti in sospeso contano. Revoca un invito in sospeso oppure passa a %3$@ (%4$@ al mese, fino a %5$lld utenti)."
          }
        }
      }
    },
    "%@ includes %lld users, and pending invitations count. Revoke a pending invitation, or upgrade to %@ (up to %lld users)." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e gli inviti in sospeso contano. Revoca un invito in sospeso oppure passa a %3$@ (fino a %4$lld utenti)."
          }
        }
      }
    },
    "%@ includes %lld users, and you can add more. Nothing is billed while no plan is assigned." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ include %2$lld utenti e puoi aggiungerne altri. Non viene fatturato nulla finché non è assegnato un piano."
          }
        }
      }
    },
    "%@ includes %lld users. Contact sales about Enterprise to add more." : {
      "localizations" : {
        "it" : {
