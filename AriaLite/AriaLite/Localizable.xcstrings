      }
    },
    "%@ will have to connect their account again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dovrà collegare di nuovo il proprio account."
          }
        }
      }
    },
    "%@ will lose access to the mobile app and free a seat. Their work orders stay as they are." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perderà l'accesso all'app mobile e libererà un posto. I suoi ordini di lavoro restano come sono."
