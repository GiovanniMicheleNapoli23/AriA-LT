    "%@ credits past the %@ included this cycle. They are not billed while no plan is assigned, and answers continue as usual." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ credits past the %2$@ included this cycle. They are not billed while no plan is assigned, and answers continue as usual."
